+fn firmware_event_flags() -> Result<u64, String> {
+    let output = Command::new("vcgencmd")
+        .arg("get_throttled")
+        .output()
+        .map_err(|error| format!("Failed to run vcgencmd: {error}"))?;
+
+    if !output.status.success() {
+        return Err(format!("vcgencmd exited with {}", output.status));
+    }
+
+    let stdout = String::from_utf8_lossy(&output.stdout);
+    stdout
+        .trim()
+        .strip_prefix("throttled=")
+        .ok_or_else(|| format!("Unexpected vcgencmd output: {stdout:?}"))
+        .and_then(|value| {
+            u64::from_str_radix(value.trim_start_matches("0x"), 16)
+                .map_err(|error| format!("Failed to parse {value:?}: {error}"))
+        })
+}
